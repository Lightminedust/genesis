# Copie ce fichier en .env (jamais versionné) et choisis deux mots de passe longs, avant `docker compose up`.
# Lettres et chiffres seulement : ils entrent dans l'adresse MONGO_URI, où @ : / # ? devraient être échappés.
# Ils ne servent qu'au premier démarrage d'un volume vide ; pour en changer ensuite :
# `docker compose down -v` (la base ne contient que la table périodique, réamorcée par le moteur).

# Le compte d'administration de MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=

# Le compte du moteur : lecture-écriture sur genesis_db seulement
GENESIS_DB_USER=genesis
GENESIS_DB_PASSWORD=
